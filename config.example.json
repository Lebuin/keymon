{
  "toggle_shortcut": "<Super><Alt>k",
  "overlay": {
    "monitor": "primary",
    "origin_h": "center",
    "origin_v": "bottom",
    "anchor_h": "center",
    "anchor_v": "bottom",
    "offset_x": 0,
    "offset_y": -80,
    "row_spacing": 8
  },
  "box": {
    "background": "rgba(0,0,0,0.8)",
    "padding_h": 16,
    "padding_v": 8,
    "corner_radius": 12,
    "animation_ms": 150,
    "enter_scale": 0,
    "animate_first": false,
    "max_width": 800
  },
  "text": {
    "color": "#ffffff",
    "held_color": "#ffcc00",
    "muted_color": "rgba(255,255,255,0.8)",
    "size": 28,
    "font": "sans",
    "weight": "normal",
    "line_height": 1.25
  },
  "keys": {
    "run_visible_ms": 3000,
    "run_gap_ms": 2000,
    "repeat_delay_ms": null,
    "shift_delay_ms": 200,
    "max_runs": 5,
    "stack_direction": "up",
    "space_symbol": "␣",
    "names": {}
  },
  "mouse": {
    "ring": {
      "radius": 28,
      "stroke_width": 3,
      "stroke_color": "#ffcc00",
      "fill_color": "rgba(0,0,0,0)"
    },
    "click": {
      "fill_color": "rgba(255,204,0,0.8)",
      "duration_ms": 150,
      "left_style": "drawing",
      "ripple_duration_ms": 300,
      "easing": "ease-out"
    }
  }
}
